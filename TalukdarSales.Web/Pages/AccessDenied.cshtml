@page
@model TalukdarSales.Web.Pages.AccessDeniedModel
@{ ViewData["Title"] = "Access denied"; }
<div class="card" style="max-width:520px;margin:40px auto;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px;padding:32px">
    <div style="width:64px;height:64px;border-radius:20px;background:var(--butter-tint);color:var(--maroon);display:flex;align-items:center;justify-content:center">@Icons.Svg("shield-lock", 30, 1.6)</div>
    <h2 style="font-size:20px">You do not have access to this page</h2>
    <p class="muted" style="margin:0">Your role does not include this permission. Ask an administrator if you need it.</p>
    <a class="btn" href="/">Back to home</a>
</div>
