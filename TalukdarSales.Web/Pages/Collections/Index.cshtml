@page
@model TalukdarSales.Web.Pages.Collections.IndexModel
@{
    ViewData["Title"] = "Collections";
    var methods = new[] { "Cash", "bKash", "Bank", "Cheque" };
    var colors = new[] { "#1F9E96", "#E5412D", "#7B4BB8", "#C98A12", "#B6A9BD" };
    var data = Model.Data;
    var byMethod = data.ByMethod;
    var max = Charts.NiceMax(Model.Last14.Select(x => x.Amount).DefaultIfEmpty(0).Max());
    string Range() => Model.Custom ? $"&from={Model.From:yyyy-MM-dd}&to={Model.To:yyyy-MM-dd}" : $"&days={Model.Days}";
    string Url(string method = null, int? days = null) => days != null ? $"/Collections?days={days}&method={Model.Method}&q={Uri.EscapeDataString(Model.Q ?? "")}"
        : $"/Collections?method={method ?? Model.Method}&q={Uri.EscapeDataString(Model.Q ?? "")}{Range()}";
}
<header class="page-head">
    <div><h1 class="page-title">Collections</h1><div class="page-sub">Every payment received, newest first</div></div>
    <div class="actions">
        <a class="btn" href="@(Url())&handler=Export">@Icons.Svg("download", 18)Export Excel</a>
        <a class="btn btn-p" href="/Invoices?status=due">Collect a payment</a>
    </div>
</header>

<form method="get" class="col" style="gap:12px">
    <input type="hidden" name="method" value="@Model.Method" />
    <div class="row between wrap" style="gap:12px">
        <div class="seg" role="group" aria-label="Period">
            @foreach (var (d, label) in new[] { (1, "Today"), (7, "7 days"), (30, "30 days"), (0, "All") })
            { <a href="@Url(days: d)" class="@(!Model.Custom && Model.Days == d ? "on" : "")">@label</a> }
        </div>
        <div class="chips">
            <a class="chip @(string.IsNullOrEmpty(Model.Method) ? "on" : "")" href="@Url("")">All methods</a>
            @foreach (var m in methods) { <a class="chip @(Model.Method == m ? "on" : "")" href="@Url(m)">@m</a> }
        </div>
    </div>
    <div class="row wrap" style="gap:8px">
        <label class="row lbl" style="gap:6px">From <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" style="width:auto" /></label>
        <label class="row lbl" style="gap:6px">To <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" style="width:auto" /></label>
        <input type="search" name="q" value="@Model.Q" placeholder="Search customer or invoice" aria-label="Search collections" style="width:240px" />
        <button class="btn">Filter</button>
        @if (Model.Custom || !string.IsNullOrEmpty(Model.Q) || !string.IsNullOrEmpty(Model.Method)) { <a class="btn" href="/Collections">Clear</a> }
    </div>
</form>

<section class="row top wrap" style="gap:20px">
    <div class="card kpi" style="flex:1 1 300px">
        <div class="lbl">Collected</div>
        <div class="v">৳ @Fmt.Int(data.Total)</div>
        <div class="lbl">@data.Payments payments</div>
        @if (byMethod.Count > 0)
        {
            <div class="stackbar" style="margin-top:6px">@for (var i = 0; i < byMethod.Count; i++) { <i style="flex:@Charts.N(byMethod[i].Amount);background:@colors[Math.Min(i, 4)]"></i> }</div>
            <div class="legend">@for (var i = 0; i < byMethod.Count; i++) { <span><i class="dot" style="background:@colors[Math.Min(i, 4)]"></i>@byMethod[i].Method · ৳ @Fmt.Int(byMethod[i].Amount)</span> }</div>
        }
    </div>
    <div class="card" style="flex:2 1 460px;min-width:0">
        <div class="ct">Last 14 days</div><div class="lbl" style="margin-bottom:10px">Collected per day</div>
        <div class="cols" style="height:120px;padding:0 4px">
            @foreach (var (day, amount) in Model.Last14)
            {
                var h = Math.Round(amount / max * 100);
                <div class="g" title="@day.ToString("ddd, d MMM"): ৳ @Fmt.Int(amount)"><i style="height:@h%;background:#1F9E96"></i></div>
            }
        </div>
        <div class="xlabels"><span>@Model.Last14.First().Day.ToString("d MMM")</span><span style="text-align:right">@Model.Last14.Last().Day.ToString("d MMM")</span></div>
    </div>
</section>

<section class="card flush">
    @if (data.Page.Items.Count == 0) { <div class="empty">No collections found.</div> }
    @foreach (var group in data.Page.Items.GroupBy(r => r.Time.Date))
    {
        <div class="list-head"><b>@(group.Key == DateTime.Today ? "Today" : group.Key == DateTime.Today.AddDays(-1) ? "Yesterday" : group.Key.ToString("dddd, d MMMM"))</b><span class="grow"></span><span class="num strong">৳ @Fmt.Int(data.DayTotals.TryGetValue(group.Key, out var dt) ? dt : 0)</span></div>
        @foreach (var r in group)
        {
            <div class="list-row">
                <span class="avatar-s">@Fmt.Initials(r.UserName)</span>
                <div class="grow" style="min-width:0"><b>@r.UserName</b><div class="lbl">@r.InvoiceNumber · @r.Time.ToString("h:mm tt")</div></div>
                <span class="pill @(r.Amount < 0 ? "bad" : "neutral")">@r.PaymentMethod</span>
                <span class="num strong" style="width:110px;text-align:right">৳ @Fmt.Money(r.Amount)</span>
            </div>
        }
    }
    <partial name="_Pager" model="data.Page.Pager(Url())" />
</section>
