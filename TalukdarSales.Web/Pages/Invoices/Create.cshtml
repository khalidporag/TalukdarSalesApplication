@page
@model TalukdarSales.Web.Pages.Invoices.CreateModel
@{ ViewData["Title"] = "Invoice Form"; }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }
<p class="text-muted">Create an invoice from an active requisition, adjusting quantities if needed. Prices come from the requisition.</p>
<form method="post">
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <label class="form-label">User group</label>
            <select class="form-select" asp-for="UserTypeId" asp-items="Model.UserTypeOptions" hx-get="/Lookup?handler=Users&placeholder=Select user" hx-target="#UserId" hx-trigger="change"
                    hx-vals='js:{typeId: document.getElementById("UserTypeId").value}'><option value="">All groups</option></select>
        </div>
        <div class="col-md-4">
            <label class="form-label">User *</label>
            <select class="form-select" asp-for="UserId" hx-get="/Lookup?handler=Requisitions" hx-target="#RequisitionId" hx-trigger="change"
                    hx-vals='js:{userId: document.getElementById("UserId").value}'>
                <option value="">Select user</option>
                @foreach (var u in Model.UserOptions) { <option value="@u.Value" selected="@(Model.UserId?.ToString() == u.Value)">@u.Text</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Requisition *</label>
            <select class="form-select" asp-for="RequisitionId" hx-get="/Invoices/Create?handler=Lines" hx-target="#lines" hx-trigger="change"
                    hx-vals='js:{requisitionId: document.getElementById("RequisitionId").value}'>
                <option value="">Select requisition</option>
                @foreach (var r in Model.RequisitionOptions) { <option value="@r.Value" selected="@(Model.RequisitionId?.ToString() == r.Value)">@r.Text</option> }
            </select>
        </div>
    </div>
    <div id="lines"><partial name="_Lines" model="Model" /></div>
</form>
