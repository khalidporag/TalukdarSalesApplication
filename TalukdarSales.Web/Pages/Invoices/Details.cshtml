@page
@model TalukdarSales.Web.Pages.Invoices.DetailsModel
@{
    ViewData["Title"] = "Invoice " + Model.Invoice.Header.Number;
    var h = Model.Invoice.Header;
    var i = 1;
    var status = h.Collected <= 0.005 ? ("Unpaid", "bad") : h.Due > 0.005 ? ("Partly paid", "warn") : ("Paid", "good");
}
<header class="page-head no-print">
    <div><h1 class="page-title">@h.Number</h1><div class="page-sub">@h.UserName · @h.CreatedDateTime.ToString("d MMM yyyy")</div></div>
    <div class="actions">
        <a class="btn" href="/Invoices">Back</a>
        <a class="btn" href="/Invoices/Details?handler=Export&id=@h.Id">@Icons.Svg("download", 18)Export Excel</a>
        <button class="btn btn-p" onclick="window.print()">@Icons.Svg("print", 18)Print</button>
    </div>
</header>

<article class="sheet">
    <div class="row between top wrap">
        <img src="~/img/logo-yellow.png" alt="Talukder Foods" style="height:78px;width:auto;border-radius:10px" />
        <div style="text-align:right">
            <div class="sec-label">Sales invoice</div>
            <div class="num" style="font-size:24px;font-weight:700;color:var(--maroon)">@h.Number</div>
            <div class="lbl">@h.CreatedDateTime.ToString("d MMM yyyy, h:mm tt")</div>
        </div>
    </div>
    <div class="row between top wrap" style="gap:24px">
        <div><div class="sec-label">Billed to</div><div class="strong" style="font-size:16px">@h.UserName</div><div class="lbl">Customer ID @Model.Invoice.UserSequentialId</div></div>
        <div style="text-align:right"><div class="sec-label">Order</div><div class="strong">@h.RequisitionNo</div><span class="pill @status.Item2 no-print">@status.Item1</span></div>
    </div>
    <table>
        <thead><tr><th style="width:44px">SL</th><th>Product</th><th class="r">Unit price</th><th class="r">Quantity</th><th class="r">Total</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Invoice.Lines)
        {
            <tr><td>@(i++)</td><td>@l.ProductName</td><td class="r num">৳ @Fmt.Money(l.Price)</td><td class="r num">@Fmt.Money(l.Quantity)</td><td class="r num">৳ @Fmt.Money(l.Total)</td></tr>
        }
        </tbody>
    </table>
    <div class="col" style="align-self:flex-end;min-width:260px;gap:8px">
        <div class="row between"><span class="muted">Invoice total</span><span class="num strong" style="font-size:18px">৳ @Fmt.Money(h.Total)</span></div>
        <div class="row between"><span class="muted">Collected</span><span class="num">৳ @Fmt.Money(h.Collected)</span></div>
        <div class="row between" style="border-top:2px solid var(--ink);padding-top:8px"><span class="strong">Due</span><span class="num" style="font-size:22px;font-weight:700;color:var(--maroon)">৳ @Fmt.Money(h.Due)</span></div>
    </div>
    <div class="lbl" style="text-align:center;border-top:1px solid var(--line);padding-top:16px">Thank you for your business · Talukder Foods</div>
</article>
