@page
@model TalukdarSales.Web.Pages.Invoices.DetailsModel
@{
    ViewData["Title"] = "Invoice " + Model.Invoice.Header.Number;
    var h = Model.Invoice.Header;
}
<div class="d-flex gap-2 mb-3 no-print">
    <button class="btn btn-success" onclick="window.print()">Print</button>
    <a class="btn btn-outline-success" href="/Invoices/Details?handler=Export&id=@h.Id">Export to Excel</a>
    <a class="btn btn-light" href="/Invoices">Back</a>
</div>
<div class="card invoice-sheet">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <div><h4 class="mb-0">Talukder Foods</h4><div class="text-muted">Sales Invoice</div></div>
            <div class="text-end"><div class="fw-bold">@h.Number</div><div>@h.CreatedDateTime.ToString("dd MMM yyyy HH:mm")</div></div>
        </div>
        <hr />
        <div class="mb-3"><div><strong>Name:</strong> @h.UserName</div><div><strong>User ID:</strong> @Model.Invoice.UserSequentialId</div></div>
        <table class="table table-bordered">
            <thead><tr><th>SL</th><th>Product Name</th><th class="text-end">Unit Price</th><th class="text-end">Quantity</th><th class="text-end">Total</th></tr></thead>
            <tbody>
            @{ var i = 1; }
            @foreach (var l in Model.Invoice.Lines)
            {
                <tr><td>@(i++)</td><td>@l.ProductName</td><td class="text-end">@l.Price.ToString("N2")</td><td class="text-end">@l.Quantity</td><td class="text-end">@l.Total.ToString("N2")</td></tr>
            }
            </tbody>
            <tfoot>
                <tr><th colspan="3">Invoice Total</th><th class="text-end">@Model.Invoice.Quantity</th><th class="text-end">@h.Total.ToString("N2")</th></tr>
                <tr><td colspan="4" class="text-end">Collected</td><td class="text-end">@h.Collected.ToString("N2")</td></tr>
                <tr><td colspan="4" class="text-end fw-bold">Due</td><td class="text-end fw-bold">@h.Due.ToString("N2")</td></tr>
            </tfoot>
        </table>
    </div>
</div>
