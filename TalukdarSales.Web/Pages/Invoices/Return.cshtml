@page
@model TalukdarSales.Web.Pages.Invoices.ReturnModel
@{
    ViewData["Title"] = "Return goods";
    var h = Model.Invoice.Header;
}
<header class="page-head">
    <div><h1 class="page-title">Return goods</h1><div class="page-sub">@h.Number · @h.UserName · the credit reduces what they owe, and any amount already paid is marked for refund</div></div>
    <div class="actions"><a class="btn" href="/Invoices/Details?id=@h.Id">Back to invoice</a></div>
</header>
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="note bad" role="alert">@Model.Error</div> }
<form method="post" class="card col" style="gap:16px;max-width:760px">
    <div>
        <div class="lbl row" style="gap:10px;padding-bottom:6px;border-bottom:1px solid var(--line)"><span class="grow">Product</span><span style="width:90px;text-align:right">Sold</span><span style="width:100px;text-align:right">Returned</span><span style="width:120px;text-align:center">Return now</span></div>
        @foreach (var l in Model.Lines)
        {
            var q = Model.Qty.TryGetValue(l.FinishedGoodId, out var v) && v > 0 ? Fmt.Money(v.Value).Replace(",", "") : "0";
            <div class="row" style="gap:10px;padding:10px 0;border-bottom:1px solid #F3EBD6">
                <div class="grow"><b>@l.ProductName</b><div class="lbl">৳ @Fmt.Money(l.Price) each</div></div>
                <span class="num" style="width:90px;text-align:right">@Fmt.Money(l.Sold)</span>
                <span class="num" style="width:100px;text-align:right">@Fmt.Money(l.Returned)</span>
                <span style="width:120px">@if (l.Left > 0) { <input type="number" name="Qty[@l.FinishedGoodId]" min="0" max="@Fmt.Money(l.Left).Replace(",", "")" step="any" value="@q" class="num" aria-label="Quantity of @l.ProductName to return" style="text-align:center" /> } else { <span class="lbl">All returned</span> }</span>
            </div>
        }
    </div>
    <div class="field"><label for="reason">Reason *</label><input id="reason" name="Reason" value="@Model.Reason" maxlength="300" required placeholder="Damaged, expired, wrong item…" /></div>
    <button class="btn btn-p btn-lg" style="align-self:flex-end">Record return</button>
</form>
