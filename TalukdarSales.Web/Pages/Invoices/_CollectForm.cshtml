@model TalukdarSales.Web.Pages.Invoices.IndexModel
<form method="post" hx-post="/Invoices?handler=Collect" hx-target="#modal-content">
    <input type="hidden" asp-for="Collect.InvoiceId" />
    <div class="modal-header"><h5 class="modal-title">Collect Amount</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <p class="mb-2"><strong>@Model.CollectInvoice.UserName</strong> &middot; @Model.CollectInvoice.Number</p>
        <p class="text-muted small">Total outstanding for this customer: <strong>@Model.UserDue.ToString("N2")</strong>. Payments are applied to the oldest invoices first.</p>
        <div class="mb-3"><label class="form-label">Amount *</label><input class="form-control" type="number" step="0.01" min="0.01" asp-for="Collect.Amount" /><span class="text-danger small" asp-validation-for="Collect.Amount"></span></div>
        <div class="mb-3"><label class="form-label">Payment method *</label>
            <input class="form-control" list="methods" asp-for="Collect.PaymentMethod" />
            <datalist id="methods"><option value="Cash"></option><option value="Bank"></option><option value="bKash"></option><option value="Cheque"></option></datalist>
            <span class="text-danger small" asp-validation-for="Collect.PaymentMethod"></span></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success">Collect</button></div>
</form>
