@model TalukdarSales.Web.Pages.Invoices.IndexModel
<div class="card-table table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>#</th><th>Invoice For</th><th>Invoice No</th><th>Requisition No</th><th>Creation Time</th><th class="text-end">Total</th><th class="text-end">Collection</th><th class="text-end">Due</th><th></th></tr></thead>
        <tbody>
        @{ var i = 1; }
        @foreach (var r in Model.Result.Rows)
        {
            <tr>
                <td>@(i++)</td>
                <td>@r.UserName</td>
                <td>@r.Number</td>
                <td>@r.RequisitionNo</td>
                <td>@r.CreatedDateTime.ToString("dd MMM yyyy HH:mm")</td>
                <td class="text-end">@r.Total.ToString("N2")</td>
                <td class="text-end">@r.Collected.ToString("N2")</td>
                <td class="text-end">@r.Due.ToString("N2")</td>
                <td class="text-end text-nowrap">
                    @if (r.Due > 0.005) { <button class="btn btn-sm btn-success" hx-get="/Invoices?handler=Collect&id=@r.Id" hx-target="#modal-content">Collect</button> }
                    <a class="btn btn-sm btn-outline-secondary" href="/Collections?invoiceId=@r.Id">History</a>
                    <a class="btn btn-sm btn-outline-secondary" href="/Invoices/Details?id=@r.Id">Print</a>
                </td>
            </tr>
        }
        @if (!Model.Result.Rows.Any()) { <tr><td colspan="9" class="text-muted">No invoices found.</td></tr> }
        </tbody>
        <tfoot>
            <tr class="fw-bold"><td colspan="5">Total</td>
                <td class="text-end bg-info-subtle">@Model.Result.Total.ToString("N2")</td>
                <td class="text-end bg-success-subtle">@Model.Result.Collected.ToString("N2")</td>
                <td class="text-end bg-danger-subtle">@Model.Result.Due.ToString("N2")</td><td></td></tr>
        </tfoot>
    </table>
</div>
