@page
@model TalukdarSales.Web.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Talukder Foods</title>
    <link rel="icon" href="~/img/logo-purple.jpg" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="auth">
    <div class="auth-hero"><div><img src="~/img/logo-yellow.png" alt="Talukder Foods" /></div></div>
    <main class="auth-form">
        <form method="post">
            <div>
                <h1 class="page-title" style="font-size:34px">Welcome back</h1>
                <div class="page-sub">Sign in to take orders, invoice and collect.</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="note bad" role="alert">@Model.Error</div>
            }
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div class="field">
                <label for="Username">Username</label>
                <input id="Username" name="Username" value="@Model.Username" autocomplete="username" autofocus required />
            </div>
            <div class="field">
                <label for="Password">Password</label>
                <input id="Password" name="Password" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-p btn-lg btn-block" type="submit">Sign in</button>
            <div class="faint" style="text-align:center;font-size:13.5px">Forgot your password? Ask an administrator to reset it.</div>
        </form>
    </main>
</div>
</body>
</html>
