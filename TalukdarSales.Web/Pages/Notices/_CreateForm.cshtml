@model TalukdarSales.Web.Pages.Notices.IndexModel
<form method="post" enctype="multipart/form-data" hx-post="/Notices?handler=Create" hx-target="#modal-content" hx-encoding="multipart/form-data">
    <div class="modal-header"><h5 class="modal-title">Create Notice</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <div class="mb-3"><label class="form-label">Title *</label><input class="form-control" asp-for="Create.Title" /><span class="text-danger small" asp-validation-for="Create.Title"></span></div>
        <div class="mb-3"><label class="form-label">Description *</label><textarea class="form-control" rows="4" asp-for="Create.Description"></textarea><span class="text-danger small" asp-validation-for="Create.Description"></span></div>
        <div><label class="form-label">Image</label><input class="form-control" type="file" accept="image/*" asp-for="Create.Image" /><span class="text-danger small" asp-validation-for="Create.Image"></span></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success">Save</button></div>
</form>
