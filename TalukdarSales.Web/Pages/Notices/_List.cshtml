@model TalukdarSales.Web.Pages.Notices.IndexModel
<div class="row g-3">
    @foreach (var n in Model.Items)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(n.LogoName)) { <img src="/images/notices/@n.LogoName" class="card-img-top" style="max-height:180px;object-fit:cover" alt="" /> }
                <div class="card-body">
                    <h6 class="card-title">@n.Title</h6>
                    <p class="card-text small text-muted" style="white-space:pre-line">@n.Description</p>
                </div>
                <div class="card-footer bg-transparent small text-muted">@n.CreatedOn.ToString("dd MMM yyyy")</div>
            </div>
        </div>
    }
    @if (!Model.Items.Any()) { <div class="col-12"><div class="alert alert-light border">No notices yet.</div></div> }
</div>
