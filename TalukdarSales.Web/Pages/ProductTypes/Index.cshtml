@page
@model TalukdarSales.Web.Pages.ProductTypes.IndexModel
@{ ViewData["Title"] = "Product Type Setup"; }
<div class="d-flex gap-2 mb-3">
    <form id="filter" class="flex-grow-1" hx-get="/ProductTypes?handler=List" hx-target="#list" hx-trigger="input changed delay:300ms from:#Name, submit">
        <input class="form-control w-auto" id="Name" name="Name" value="@Model.Name" placeholder="Search by name" autocomplete="off" />
    </form>
    <button class="btn btn-success" hx-get="/ProductTypes?handler=Create" hx-target="#modal-content">Add Product Type</button>
</div>
<div id="list" hx-get="/ProductTypes?handler=List" hx-include="#filter" hx-trigger="refreshList from:body">
    <partial name="_List" model="Model" />
</div>
