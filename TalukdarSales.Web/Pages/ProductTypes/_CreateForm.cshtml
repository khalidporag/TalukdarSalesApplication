@model TalukdarSales.Web.Pages.ProductTypes.IndexModel
<form method="post" hx-post="/ProductTypes?handler=Create" hx-target="#modal-content">
    <div class="modal-header"><h5 class="modal-title">Add Product Type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <label class="form-label">Name *</label>
        <input class="form-control" asp-for="Create.Name" />
        <span class="text-danger small" asp-validation-for="Create.Name"></span>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>
