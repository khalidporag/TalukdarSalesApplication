@model TalukdarSales.Web.Pages.ProductTypes.IndexModel
<div class="card-table">
    <table class="table table-hover mb-0">
        <thead><tr><th style="width:80px">#</th><th>Name</th></tr></thead>
        <tbody>
        @foreach (var t in Model.Items)
        {
            <tr><td>@t.Id</td><td>@t.Name</td></tr>
        }
        @if (!Model.Items.Any()) { <tr><td colspan="2" class="text-muted">No product types found.</td></tr> }
        </tbody>
    </table>
</div>
