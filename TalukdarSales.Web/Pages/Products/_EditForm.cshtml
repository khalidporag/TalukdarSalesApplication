@model TalukdarSales.Web.Pages.Products.IndexModel
<form method="post" hx-post="/Products?handler=Edit" hx-target="#modal-content">
    <input type="hidden" asp-for="Edit.Id" />
    <div class="modal-header"><h5 class="modal-title">Edit @Model.Edit.Name</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
        <div class="mb-3"><label class="form-label">Unit price *</label><input class="form-control" type="number" step="0.01" min="0" asp-for="Edit.UnitPrice" /><span class="text-danger small" asp-validation-for="Edit.UnitPrice"></span></div>
        <div class="mb-3"><label class="form-label">Description *</label><textarea class="form-control" rows="2" asp-for="Edit.Description"></textarea><span class="text-danger small" asp-validation-for="Edit.Description"></span></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="Edit.IsActive" /><label class="form-check-label" asp-for="Edit.IsActive">Active</label></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success">Save</button></div>
</form>
