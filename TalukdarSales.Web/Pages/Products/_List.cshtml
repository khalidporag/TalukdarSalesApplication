@model TalukdarSales.Web.Pages.Products.IndexModel
<div class="card-table">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th></th><th>Name</th><th>Type</th><th>UOM</th><th class="text-end">Unit price</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var g in Model.Items.Items)
        {
            <tr>
                <td style="width:56px"><img src="@(string.IsNullOrEmpty(g.LogoName) ? "/img/no-user.jpeg" : "/images/products/" + g.LogoName)" onerror="this.onerror=null;this.src='/img/no-user.jpeg'" style="width:40px;height:40px;object-fit:cover" class="rounded" alt="" /></td>
                <td>@g.Name<div class="small text-muted">@g.Description</div></td>
                <td>@(Model.TypeNames.TryGetValue(g.GoodTypeId, out var tn) ? tn : "")</td>
                <td>@g.UOM</td>
                <td class="text-end">@g.UnitPrice.ToString("N2")</td>
                <td>@if (g.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
                <td class="text-end"><button class="btn btn-sm btn-outline-success" hx-get="/Products?handler=Edit&id=@g.Id" hx-target="#modal-content">Edit</button></td>
            </tr>
        }
        @if (!Model.Items.Items.Any()) { <tr><td colspan="7" class="text-muted">No products found.</td></tr> }
        </tbody>
    </table>
</div>
<div class="mt-3">
    <partial name="_Pager" model='(Model.Items.Page, Model.Items.TotalPages, $"/Products?handler=List&Name={Uri.EscapeDataString(Model.Name ?? "")}&TypeId={Model.TypeId}", "#list")' />
</div>
