@page
@model TalukdarSales.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = "Reports"; }
<p class="text-muted">Each report defaults to the last month. Pick a date range to change it.</p>
<div class="row g-3">
@foreach (var (kind, title) in TalukdarSales.Web.Pages.Reports.IndexModel.Panels)
{
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <strong>@title</strong>
                <form class="d-flex gap-1 align-items-center" id="f-@kind" hx-get="/Reports?handler=Panel&kind=@kind" hx-target="#p-@kind" hx-trigger="change">
                    <input class="form-control form-control-sm" type="date" name="From" title="From" />
                    <input class="form-control form-control-sm" type="date" name="To" title="To" />
                    <a class="btn btn-sm btn-outline-success" href="#" onclick="this.href='/Reports?handler=Export&kind=@kind&'+new URLSearchParams(new FormData(document.getElementById('f-@kind'))).toString()">Excel</a>
                </form>
            </div>
            <div class="card-body p-0" id="p-@kind" hx-get="/Reports?handler=Panel&kind=@kind" hx-trigger="load">
                <div class="p-3 text-muted">Loading…</div>
            </div>
        </div>
    </div>
}
</div>
