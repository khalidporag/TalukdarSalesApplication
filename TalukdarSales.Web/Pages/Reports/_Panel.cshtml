@model TalukdarSales.Web.Pages.Reports.IndexModel
@{
    string Img(string folder, string name) => string.IsNullOrEmpty(name) ? "/img/no-user.jpeg" : $"/images/{folder}/{name}";
}
<div class="table-responsive" style="max-height:420px">
<table class="table table-sm align-middle mb-0">
@switch (Model.Kind)
{
    case "sellers":
        <thead><tr><th>#</th><th></th><th>Name</th><th class="text-end">Amount</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.TopSellers.Count; i++)
        {
            var s = Model.TopSellers[i];
            <tr><td>@(i + 1)</td><td style="width:44px"><img src="@Img("users", s.ImageName)" onerror="this.onerror=null;this.src='/img/no-user.jpeg'" class="rounded-circle" style="width:32px;height:32px;object-fit:cover" alt="" /></td><td>@s.UserName</td><td class="text-end">@s.Amount.ToString("N2")</td></tr>
        }
        @if (!Model.TopSellers.Any()) { <tr><td colspan="4" class="text-muted p-3">No data for this period.</td></tr> }
        </tbody>
        break;
    case "best":
    case "worst":
        var list = Model.Kind == "best" ? Model.BestProducts : Model.WorstProducts;
        <thead><tr><th>#</th><th></th><th>Product</th><th class="text-end">Sales</th></tr></thead>
        <tbody>
        @for (var i = 0; i < list.Count; i++)
        {
            var p = list[i];
            <tr><td>@(i + 1)</td><td style="width:44px"><img src="@Img("products", p.LogoName)" onerror="this.onerror=null;this.src='/img/no-user.jpeg'" class="rounded" style="width:32px;height:32px;object-fit:cover" alt="" /></td><td>@p.ProductName</td><td class="text-end">@p.Quantity</td></tr>
        }
        @if (!list.Any()) { <tr><td colspan="4" class="text-muted p-3">No data for this period.</td></tr> }
        </tbody>
        break;
    case "due":
        <thead><tr><th>#</th><th>Name</th><th>Phone</th><th class="text-end">Due</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.DueUsers.Count; i++)
        {
            var u = Model.DueUsers[i];
            <tr><td>@(i + 1)</td><td>@u.UserName</td><td>@u.Phone</td><td class="text-end">@u.Due.ToString("N2")</td></tr>
        }
        @if (!Model.DueUsers.Any()) { <tr><td colspan="4" class="text-muted p-3">No outstanding dues for this period.</td></tr> }
        </tbody>
        break;
    default:
        <thead><tr><th>Date</th><th>Product</th><th class="text-end">Quantity</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Daily)
        {
            <tr><td>@d.Date.ToString("dd MMM yyyy")</td><td>@d.ProductName</td><td class="text-end">@d.Quantity</td></tr>
        }
        @if (!Model.Daily.Any()) { <tr><td colspan="3" class="text-muted p-3">No data for this period.</td></tr> }
        </tbody>
        break;
}
</table>
</div>
