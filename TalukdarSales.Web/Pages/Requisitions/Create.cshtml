@page
@model TalukdarSales.Web.Pages.Requisitions.CreateModel
@using TalukdarSales.Web.Infrastructure
@{
    ViewData["Title"] = "New order";
    string Mono(string n) => Fmt.Initials(n);
}
<header class="page-head">
    <div><h1 class="page-title">@(Model.EditId != null ? "Edit " + Model.EditSerial : "New order")</h1><div class="page-sub">@(Model.EditId != null ? "Change the quantities. Products already on the order keep their price." : "Pick a customer, tap products, send. Prices come from the catalogue.")</div></div>
    <span class="pill @(Model.IsOpen ? "good" : "warn")" style="min-height:36px;padding:0 14px">@Icons.Svg("clock", 14)@(Model.IsOpen ? Model.WindowText : "Orders are closed right now · " + Model.WindowText)</span>
</header>

@if (!string.IsNullOrEmpty(Model.Error)) { <div class="note bad" role="alert">@Model.Error</div> }

<form method="post" id="order" class="row top wrap" style="gap:22px">
    <input type="hidden" name="UserId" id="UserId" value="@Model.UserId" />
    <div class="col grow" style="flex:1 1 560px;min-width:0;gap:22px">
        <section class="card col" style="gap:16px">
            <div class="row" style="gap:10px"><span class="step-no">1</span><div class="ct">Customer</div></div>
            <div class="chips" hidden="@(Model.EditId != null)">
                <input id="cust-search" type="search" autocomplete="off" placeholder="Search name, phone or ID" class="grow" style="flex:1 1 240px" aria-label="Search customers" />
                @foreach (var c in Model.Recent)
                {
                    <button type="button" class="chip cust" data-id="@c.Id" data-name="@c.Name" data-code="@c.Code" data-phone="@c.Phone" data-due="@c.Due" data-limit="@c.Limit" data-days="@c.CreditDays">@c.Name</button>
                }
            </div>
            <div id="cust-results" class="cust-results" hidden>
                @foreach (var c in Model.Customers)
                {
                    <button type="button" class="cust" data-id="@c.Id" data-name="@c.Name" data-code="@c.Code" data-phone="@c.Phone" data-due="@c.Due" data-limit="@c.Limit" data-days="@c.CreditDays" data-q="@((c.Name + " " + c.Code + " " + c.Phone).ToLowerInvariant())">
                        <b>@c.Name</b><small>@c.Code · @c.Phone</small>
                    </button>
                }
                <div class="muted" id="cust-none" hidden style="padding:10px 14px">No customer matches.</div>
            </div>
            <div class="selected-cust" id="cust-card" hidden>
                <div class="avatar big" id="cc-initials"></div>
                <div class="grow" style="min-width:0"><div class="strong" style="font-size:16px" id="cc-name"></div><div class="lbl" id="cc-meta"></div></div>
                <div class="col" style="flex:1 1 260px;gap:6px">
                    <div class="row between lbl"><span>Credit used</span><span class="num strong" style="color:var(--ink)" id="cc-credit"></span></div>
                    <div class="meter thick" style="background:#fff"><i id="cc-due" style="background:#7B4BB8"></i><i id="cc-order" style="background:#E5412D"></i></div>
                    <div class="legend" style="font-size:12.5px"><span><i class="dot" style="background:#7B4BB8"></i>Already owed</span><span><i class="dot" style="background:#E5412D"></i>This order</span></div>
                </div>
            </div>
        </section>

        <section class="card col" style="gap:16px">
            <div class="row" style="gap:10px"><span class="step-no">2</span><div class="ct">Products</div></div>
            <div class="chips">
                <input id="prod-search" type="search" autocomplete="off" placeholder="Search products" style="flex:1 1 200px" aria-label="Search products" />
                <button type="button" class="chip on cat" data-cat="">All</button>
                @foreach (var c in Model.Categories) { <button type="button" class="chip cat" data-cat="@c">@c</button> }
            </div>
            <div class="product-grid">
                @foreach (var p in Model.Products)
                {
                    var q = Model.Qty.TryGetValue(p.Id, out var v) && v > 0 ? v.Value : 0;
                    <div class="product" data-id="@p.Id" data-name="@p.Name" data-cat="@p.Category" data-price="@p.Price">
                        <div class="row top" style="gap:12px">
                            <div class="tile cat-@p.CategoryIndex">@Mono(p.Name)</div>
                            <div style="min-width:0"><div class="strong" style="line-height:1.25">@p.Name</div><div class="lbl">@p.Category</div></div>
                        </div>
                        <div class="row between"><span class="num strong" style="font-size:18px">৳ @Fmt.Money(p.Price)</span><span class="lbl">per @(string.IsNullOrWhiteSpace(p.Uom) ? "pack" : p.Uom)</span></div>
                        <div class="row" style="gap:8px">
                            <button type="button" class="btn add" style="flex:1;border-color:var(--red);color:var(--red)">Add</button>
                            <div class="row stepper" style="flex:1;gap:6px" hidden>
                                <button type="button" class="step dec" aria-label="Decrease">−</button>
                                <input class="qty num" type="number" min="0" step="any" inputmode="decimal" name="Qty[@p.Id]" value="@(q > 0 ? Fmt.Money(q).Replace(",", "") : "0")" aria-label="Quantity of @p.Name" />
                                <button type="button" class="step inc" aria-label="Increase">+</button>
                            </div>
                            <button type="button" class="btn add12" style="padding:0 12px;color:var(--ink-2)" aria-label="Add 12 packs">+12</button>
                        </div>
                    </div>
                }
                <div class="muted" id="prod-none" hidden>No products match.</div>
            </div>
        </section>
    </div>

    <aside class="card cart" id="cart">
        <div class="row between" style="align-items:baseline"><div class="ct">Order summary</div><span class="lbl" id="cart-count">0 items</span></div>
        <div id="cart-lines"></div>
        <div id="cart-empty" class="empty-dash">Tap Add on a product to start the order</div>
        <div class="row between" style="font-size:15px"><span class="muted">Total</span><span class="num" style="font-size:28px;font-weight:700;color:var(--maroon)" id="cart-total">৳ 0</span></div>
        <div class="note" id="cart-warn" hidden></div>
        <button class="btn btn-p btn-lg btn-block" id="send" disabled>@(Model.EditId != null ? "Save changes" : "Send order")</button>
        <div class="lbl" id="send-hint">Choose a customer and at least one product.</div>
    </aside>
</form>
<div class="mobilebar" id="mobilebar" hidden>
    <div><div class="lbl" style="color:#E7DAF0" id="mb-count">0 items</div><div class="num strong" id="mb-total" style="font-size:20px">৳ 0</div></div>
    <a class="btn btn-p" href="#cart">Review order</a>
</div>

@section Scripts { <script src="~/js/order.js" asp-append-version="true"></script> }
