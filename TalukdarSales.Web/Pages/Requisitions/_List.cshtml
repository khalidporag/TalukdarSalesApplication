@model TalukdarSales.Web.Pages.Requisitions.IndexModel
<form id="approve-form">
    @if (Model.Active && Model.Rows.Items.Any())
    {
        <div class="mb-2">
            <button type="button" class="btn btn-success btn-sm" hx-post="/Requisitions?handler=Approve" hx-include="#approve-form, #filter" hx-target="#list"
                    data-confirm="Create invoices for the selected requisitions?">Approve Selected</button>
        </div>
    }
    <div class="card-table">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    @if (Model.Active) { <th style="width:40px"><input type="checkbox" class="form-check-input" onclick="document.querySelectorAll('#approve-form .row-check').forEach(c => c.checked = this.checked)" /></th> }
                    <th>Requisition No</th><th>Requisition By</th><th>Creation Time</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows.Items)
            {
                <tr>
                    @if (Model.Active) { <td><input type="checkbox" class="form-check-input row-check" name="ids" value="@r.Id" /></td> }
                    <td>@r.Serial</td>
                    <td>@r.UserName</td>
                    <td>@r.CreatedDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Requisitions/Details?id=@r.Id">Details</a></td>
                </tr>
            }
            @if (!Model.Rows.Items.Any()) { <tr><td colspan="5" class="text-muted">No requisitions found.</td></tr> }
            </tbody>
        </table>
    </div>
</form>
<div class="mt-3">
    <partial name="_Pager" model='(Model.Rows.Page, Model.Rows.TotalPages, $"/Requisitions?handler=List&Active={Model.Active.ToString().ToLower()}&TypeId={Model.TypeId}&UserId={Model.UserId}&Serial={Uri.EscapeDataString(Model.Serial ?? "")}&From={Model.From:yyyy-MM-dd}&To={Model.To:yyyy-MM-dd}", "#list")' />
</div>
