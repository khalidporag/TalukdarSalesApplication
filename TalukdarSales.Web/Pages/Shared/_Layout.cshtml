@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var path = Context.Request.Path.Value ?? "/";
    bool Active(params string[] prefixes) => prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase) || (p != "/" && path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase)));
    string Cls(params string[] prefixes) => Active(prefixes) ? "nav-link active" : "nav-link";
    var displayName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Talukder Foods") - Talukder Foods</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}' hx-ext="">
<div class="app-shell">
    <aside class="app-sidebar">
        <a class="brand" href="/">
            <img src="~/img/logo-small.jpg" alt="" /> <span>Talukder Foods</span>
        </a>
        <nav class="nav flex-column">
            <a class="@Cls("/")" href="/">Notices</a>
            <a class="@Cls("/Dashboard")" href="/Dashboard">Dashboard</a>

            <div class="nav-group">User Administration</div>
            <a class="@Cls("/Users")" href="/Users">User Management</a>
            <a class="@Cls("/Roles")" href="/Roles">Role Management</a>

            <div class="nav-group">Sales Requisition</div>
            <a class="@Cls("/Requisitions/Create")" href="/Requisitions/Create">Requisition Form</a>
            <a class="@Cls("/Requisitions")" href="/Requisitions">Requisition List</a>

            <div class="nav-group">Sales Invoice</div>
            <a class="@Cls("/Invoices/Create")" href="/Invoices/Create">Invoice Form</a>
            <a class="@Cls("/Invoices")" href="/Invoices">Invoice List</a>
            <a class="@Cls("/Collections")" href="/Collections">Collection History</a>

            <div class="nav-group">Operations</div>
            <a class="@Cls("/Production")" href="/Production">Production Planning</a>
            <a class="@Cls("/Notices")" href="/Notices">Notices</a>
            <a class="@Cls("/Reports")" href="/Reports">Reports</a>

            <div class="nav-group">Settings</div>
            <a class="@Cls("/ProductTypes")" href="/ProductTypes">Product Type Setup</a>
            <a class="@Cls("/Products")" href="/Products">Product Setup</a>
            <a class="@Cls("/TimeSetting")" href="/TimeSetting">Time Setting</a>
        </nav>
    </aside>

    <div class="app-main">
        <header class="app-header">
            <h1 class="h5 mb-0">@ViewData["Title"]</h1>
            <div class="d-flex align-items-center gap-3">
                <span>@displayName</span>
                <form method="post" action="/Logout"><button class="btn btn-sm btn-outline-secondary">Logout</button></form>
            </div>
        </header>
        <main class="app-content">
            @RenderBody()
        </main>
    </div>
</div>

<div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content" id="modal-content"></div></div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" id="toasts"></div>

<script src="~/lib/htmx/htmx.min.js"></script>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
