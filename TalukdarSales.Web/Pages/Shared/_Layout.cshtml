@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject TalukdarSales.Web.Services.RequisitionService Reqs
@inject TalukdarSales.Web.Services.NotificationService Notes
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var path = Context.Request.Path.Value ?? "/";
    bool Active(params string[] prefixes) => prefixes.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase) || (p != "/" && path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase)));
    var access = Access.For(User);
    bool Can(string key) => access.Has(key);
    var displayName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "";
    var waiting = Can(Perm.RequisitionView) ? Reqs.WaitingCount() : 0;
    var unread = Notes.UnreadCount(int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var uid) ? uid : 0);
    var home = Can(Perm.Dashboard) ? "/Dashboard" : "/";
    var role = access.IsAdmin ? "Administrator" : string.Join(", ", access.RoleNames);

    // (label, href, permission, icon, active prefixes, badge)
    var groups = new (string Label, (string Text, string Href, string Perm, string Icon, string[] On, int Badge)[] Items)[]
    {
        ("Overview", new[]
        {
            ("Dashboard", "/Dashboard", Perm.Dashboard, "dashboard", new[] { "/Dashboard" }, 0),
            ("KPI report", "/Reports", Perm.Reports, "reports", new[] { "/Reports" }, 0),
            ("Notices", "/", null, "megaphone", new[] { "/" }, 0),
            ("Notifications", "/Notifications", null, "notices", new[] { "/Notifications" }, unread),
        }),
        ("Sell", new[]
        {
            ("New order", "/Requisitions/Create", Perm.RequisitionCreate, "new-order", new[] { "/Requisitions/Create" }, 0),
            ("Orders to invoice", "/Requisitions", Perm.RequisitionView, "orders", new[] { "/Requisitions" }, waiting),
            ("Invoices", "/Invoices", Perm.InvoiceView, "invoices", new[] { "/Invoices" }, 0),
            ("Collections", "/Collections", Perm.CollectionView, "collections", new[] { "/Collections" }, 0),
        }),
        ("Operate", new[]
        {
            ("Production plan", "/Production", Perm.Production, "production", new[] { "/Production" }, 0),
            ("Products", "/Products", Perm.Products, "products", new[] { "/Products" }, 0),
            ("Customers", "/Users", Perm.Users, "customers", new[] { "/Users" }, 0),
        }),
        ("Admin", new[]
        {
            ("Roles", "/Roles", Perm.Roles, "roles", new[] { "/Roles" }, 0),
            ("Order window", "/TimeSetting", Perm.TimeSetting, "clock", new[] { "/TimeSetting" }, 0),
            ("Audit log", "/Audit", Perm.AuditView, "list", new[] { "/Audit" }, 0),
        }),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Talukder Foods") · Talukder Foods</title>
    <link rel="icon" href="~/img/logo-purple.jpg" />
    <link rel="preload" href="~/fonts/rubik-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body hx-headers='{"RequestVerificationToken": "@token"}'>
<div class="shell">
    <aside class="side">
        <a class="logo-tile" href="@home" aria-label="Talukder Foods home"><img src="~/img/logo-purple.jpg" alt="Talukder Foods" /></a>
        <nav class="nav" aria-label="Main">
            @foreach (var g in groups)
            {
                var items = g.Items.Where(i => i.Perm == null || Can(i.Perm)).ToList();
                if (items.Count == 0) { continue; }
                <div class="nav-group">
                    <div class="nav-label">@g.Label</div>
                    @foreach (var i in items)
                    {
                        <a href="@i.Href" class="@(Active(i.On) && !(i.Href == "/Requisitions" && Active("/Requisitions/Create")) ? "on" : "")">
                            @Icons.Svg(i.Icon)
                            <span class="grow">@i.Text</span>
                            @if (i.Badge > 0) { <span class="badge">@i.Badge</span> }
                        </a>
                    }
                </div>
            }
        </nav>
        <div class="me">
            <div class="avatar">@Fmt.Initials(displayName)</div>
            <div class="who"><b>@displayName</b><small>@role</small></div>
            <form method="post" action="/Logout"><button aria-label="Sign out" title="Sign out">@Icons.Svg("logout", 18)</button></form>
        </div>
    </aside>
    <main class="content">
        @RenderBody()
    </main>
</div>
@if (TempData["Flash"] is string flash && flash.Length > 0) { <span data-flash="@flash" hidden></span> }
<div class="toasts" id="toasts" role="status" aria-live="polite"></div>
<script src="~/lib/htmx/htmx.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
