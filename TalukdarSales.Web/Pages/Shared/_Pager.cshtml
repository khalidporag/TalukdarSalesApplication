@* Model: (int Page, int TotalPages, string Url, string Target) – Url is a query-string base; links use plain GET (?p=). Target is unused and kept for callers. *@
@model (int Page, int TotalPages, string Url, string Target)
@if (Model.TotalPages > 1)
{
    var sep = Model.Url.Contains('?') ? "&" : "?";
    <nav class="pager" aria-label="Pages">
        @if (Model.Page > 1) { <a href="@(Model.Url)@(sep)p=@(Model.Page - 1)" aria-label="Previous page">@Icons.Svg("chevron-left", 16)</a> }
        @for (var i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
        {
            <a href="@(Model.Url)@(sep)p=@i" class="@(i == Model.Page ? "on" : "")" aria-current="@(i == Model.Page ? "page" : null)">@i</a>
        }
        @if (Model.Page < Model.TotalPages) { <a href="@(Model.Url)@(sep)p=@(Model.Page + 1)" aria-label="Next page">@Icons.Svg("chevron-right", 16)</a> }
    </nav>
}
