@page
@model TalukdarSales.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Customers";
    var u0 = Model.Users;
    string Url(int? typeId = null, bool keepType = true) => $"/Users?name={Uri.EscapeDataString(Model.Name ?? "")}&typeId={(keepType ? Model.TypeId : typeId)}";
    string Img(string n) => string.IsNullOrEmpty(n) ? null : "/images/users/" + n;
}
<header class="page-head">
    <div><h1 class="page-title">Customers</h1><div class="page-sub">Everyone who orders from you, with their credit position</div></div>
    <div class="actions"><a class="btn btn-p" href="@Url()&new=true">@Icons.Svg("plus", 18, 2.2)New customer</a></div>
</header>

<form method="get" class="row between wrap" style="gap:12px">
    <div class="chips">
        <a class="chip @(Model.TypeId == null ? "on" : "")" href="@Url(null, false)">All</a>
        @foreach (var t in Model.UserTypeOptions) { <a class="chip @(Model.TypeId?.ToString() == t.Value ? "on" : "")" href="/Users?name=@Uri.EscapeDataString(Model.Name ?? "")&typeId=@t.Value">@t.Text</a> }
    </div>
    <div class="row" style="gap:8px">
        <input type="hidden" name="typeId" value="@Model.TypeId" />
        <input type="search" name="name" value="@Model.Name" placeholder="Search name, phone or ID" aria-label="Search customers" style="width:260px" />
        <button class="btn" aria-label="Search">@Icons.Svg("chevron-right", 18)</button>
    </div>
</form>

<div class="row top wrap" style="gap:22px">
    <section class="card flush grow" style="flex:1 1 560px;min-width:0">
        @if (!u0.Items.Any()) { <div class="empty">No customers found.</div> }
        @foreach (var u in u0.Items)
        {
            var name = $"{u.FirstName} {u.LastName}".Trim();
            var pct = u.MaxCreditLimit <= 0 ? 0 : Math.Min(100, Math.Round(u.DueAmount / u.MaxCreditLimit * 100));
            var over = u.MaxCreditLimit > 0 && u.DueAmount >= u.MaxCreditLimit;
            <div class="list-row @(Model.EditId == u.Id ? "focus" : "")">
                <span class="avatar-s">@if (Img(u.ImageName) is { } src) { <img src="@src" alt="" onerror="this.remove()" /> } else { @Fmt.Initials(name) }</span>
                <div class="grow" style="min-width:0">
                    <div class="row wrap" style="gap:8px"><b>@name</b>@if (Model.RoleByUser.TryGetValue(u.Id, out var roleName)) { <span class="pill info">@roleName</span> }@if (over) { <span class="pill bad">Over limit</span> }</div>
                    <div class="lbl">@u.UserTypeName · @u.PhoneNumber · @u.Username</div>
                </div>
                <div style="width:170px" class="col">
                    <div class="row between lbl"><span>Owes</span><span class="num strong" style="color:var(--ink)">৳ @Fmt.Int(u.DueAmount)</span></div>
                    <div class="meter @(over ? "" : "violet")" style="@(over ? "background:var(--bad-bg)" : "")"><i style="width:@pct%;@(over ? "background:#D7261F" : "")"></i></div>
                    <div class="lbl" style="font-size:12px">@(u.MaxCreditLimit > 0 ? "of ৳ " + Fmt.Int(u.MaxCreditLimit) + " · " + u.MaxCreditDays + " days" : "No credit limit")</div>
                </div>
                <a class="btn btn-s" href="@Url()&editId=@u.Id">Edit</a>
            </div>
        }
        <partial name="_Pager" model='(u0.Page, u0.TotalPages, Url(), "")' />
    </section>

    @if (Model.Mode != null)
    {
        <aside class="card panel" id="panel"><partial name="_Form" model="Model" /></aside>
    }
</div>
