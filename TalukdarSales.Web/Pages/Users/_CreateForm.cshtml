@model TalukdarSales.Web.Pages.Users.IndexModel
<form method="post" enctype="multipart/form-data" asp-page-handler="Create"
      hx-post="/Users?handler=Create" hx-target="#modal-content" hx-encoding="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">Create User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">User group *</label>
                <select class="form-select" asp-for="Create.UserTypeId" asp-items="Model.UserTypeOptions"><option value="0">Select…</option></select>
                <span class="text-danger small" asp-validation-for="Create.UserTypeId"></span>
            </div>
            @if (Model.CanAssignRoles)
            {
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select class="form-select" asp-for="Create.RoleId" asp-items="Model.RoleOptions"><option value="0">None</option></select>
                    <span class="text-danger small" asp-validation-for="Create.RoleId"></span>
                </div>
            }
            <div class="col-md-6">
                <label class="form-label">First name *</label>
                <input class="form-control" asp-for="Create.FirstName" />
                <span class="text-danger small" asp-validation-for="Create.FirstName"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Last name</label>
                <input class="form-control" asp-for="Create.LastName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone number * <span class="text-muted small">(initial password)</span></label>
                <input class="form-control" asp-for="Create.PhoneNumber" />
                <span class="text-danger small" asp-validation-for="Create.PhoneNumber"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Address</label>
                <input class="form-control" asp-for="Create.Address" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Max credit limit</label>
                <input class="form-control" type="number" step="0.01" min="0" asp-for="Create.MaxCreditLimit" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Max credit days</label>
                <input class="form-control" type="number" min="0" asp-for="Create.MaxCreditDays" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Contact person</label>
                <input class="form-control" asp-for="Create.ContactPersonName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Contact person phone</label>
                <input class="form-control" asp-for="Create.ContactPersonPhone" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Photo</label>
                <input class="form-control" type="file" asp-for="Create.Image" accept="image/*" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="Create.IsPayRollUser" /><label class="form-check-label" asp-for="Create.IsPayRollUser">Payroll user</label></div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Create</button>
    </div>
</form>
