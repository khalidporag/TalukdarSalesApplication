@model TalukdarSales.Web.Pages.Users.IndexModel
<form method="post" hx-post="/Users?handler=Edit" hx-target="#modal-content">
    <input type="hidden" asp-for="Edit.Id" />
    <div class="modal-header">
        <h5 class="modal-title">Edit User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div class="mb-3">
            <label class="form-label">First name *</label>
            <input class="form-control" asp-for="Edit.FirstName" />
            <span class="text-danger small" asp-validation-for="Edit.FirstName"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Last name</label>
            <input class="form-control" asp-for="Edit.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Max credit limit</label>
            <input class="form-control" type="number" step="0.01" min="0" asp-for="Edit.MaxCreditLimit" />
            <span class="text-danger small" asp-validation-for="Edit.MaxCreditLimit"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save</button>
    </div>
</form>
